; XAU_AI_PRO — ETAPA 20.14-C / F1 — PRESET INSTANCIA UNICA (11 SIMBOLOS)
; Data: 2026-08-31 | After FAIL 20.14-C (dup-exec structural)
; Base: FASE_FINAL_20_5.SYMBOLS_AMPLIADO.set (baseline validado)
;
; F1 = 1 unica instancia do EA + EnableMultiSymbol=true
;   -> elimina a corrida entre 11 copias (causa raiz do dup-exec)
;   -> o pipeline ja varre todos os simbolos da lista
; SEM alteracao de codigo. Nao misturar com: OrderRetry, ADX 4807, IA ON, SL/TP.
;
; COMO APLICAR (unico passo manual, pois MCP nao anexa EA com inputs):
;   1) Remover o EA de QUALQUER grafico restante (ou reabrir o chart XAUUSD M5)
;   2) Arrastar XAU_AI_PRO para o grafico e escolher este preset
;   3) Verificar no log: "SYMBOL MANAGER | Total active symbols: 11"

AutoTrade=true
MagicNumber=2026001
TradeComment=XAU_AI_PRO

UseRiskManagement=true
LotSize=0.01
RiskPercent=1.0
MaxDailyLossPercent=5.0
MaxDrawdownPercent=15.0
MinEquityPercent=10.0
MinFreeMargin=20.0
MaxTradesPerDay=20
MaxOpenPositions=5
AllowMinLotOverride=true

MaxSpread=50
MaxSpreadBySymbol=GOLD#:350,BTCUSD#:600,ETHUSD#:600
Slippage=5
RetryMaxAttempts=5
RetryBaseDelayMs=100
RetryDelayMultiplier=2.0
RetryMaxDelayMs=2000
RetryMaxSlippage=50
RetrySlippageIncrement=2

StopLossPoints=300
TakeProfitPoints=600

EnableBreakEven=true
BreakEvenTrigger=80
BreakEvenOffset=10
EnableTrailingATR=true
ATRMultiplier=1.2
EnablePartialClose=true
PartialTrigger=150
PartialPercent=30.0

EnableSpreadFilter=true
EnableSessionFilter=false
EnableTrendFilter=true
EnableVolatilityFilter=false
EnableADXFilter=true
EnableMTFConfirmation=false
EnableNewsFilter=false
EnableAIFilter=true
NewsCurrencies=
NewsImpactThreshold=2
NewsMinutesBefore=30
NewsMinutesAfter=30

MinAIConfidence=50.0
RequireAIJSON=false
MaxPredictionAgeSec=900
KCI_VD_Period=14
KCI_DX_BasePeriod=9
KCI_DX_ZScorePeriod=30
KCI_DX_Sensitivity=1.5
KCI_DX_MainThreshold=30.0

TradeStartHour=0
TradeEndHour=24

FastEMA=50
SlowEMA=200
RSIPeriod=14
RSIPullbackBuy=45.0
RSIPullbackSell=55.0
ATRPeriod=14
ADXPeriod=14
MinimumADX=18.0

EnableScheduler=true
SchedulerIntervalSec=60
EnableWeekendShutdown=true
EnableDatabase=false
DatabasePath=XAU_AI_PRO.db
EnableTelemetry=true
EnableDataset=true
SaveDatasetCSV=true
EnableBacktestLog=true
EnableDashboard=true
EnableLogs=true
DebugTradeDecision=true

EnableHealthMonitor=true
HealthCheckInterval=60
HealthWatchdogInterval=120
EnableAuditLog=true
EnableDiagnostics=true

; === F1: INSTANCIA UNICA + 11 SIMBOLOS OFICIAIS ===
EnableMultiSymbol=true
Symbols=XAUUSD,EURUSD,USDBRL,NZDUSD,USDCHF,AUDUSD,USDSEK,GBPUSD,USDCAD,USDJPY,USDCNH

; FORA DA LISTA ATIVA (ate normalizacao de risco por simbolo):
; XAGUSD,US30,US500,USTEC

EnableVerboseDebug=true
# ============================================================
# MQL5 / MetaTrader 5 - .gitignore
# Projeto: XAU_AI_PRO v1.2.0
# ============================================================

# --- Compiled / Binary Output ---
*.ex5
*.ex4
*.dll

# --- Logs ---
*.log

# --- Data / Temp Files ---
**/Data/*.csv
**/Data/prediction_*.json
*.dat
*.db
*.sqlite
*.sqlite3
*.tmp
*.cache

# --- MQL5 Editor / MetaEditor ---
.mq5.user/
*.mq5.user

# --- Python / AI Pipeline ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.venv/
venv/

# --- Temp / Backup ---
Files/Temp/
Files/Backup/
*~
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# --- MetaTrader Auto-generated Profiles ---
# (arquivos criados/alterados automaticamente pelo terminal)
Profiles/Charts/**/*.chr
Profiles/Charts/**/*.chr.bak*
Profiles/Charts/**/*.wnd
Profiles/deleted/
Profiles/Tester/*.ini

# --- MQL5 Logs Directory ---
logs/

# --- Preserve ---
# *.mq5       (Expert Advisors - source)
# *.mqh       (Include files - source)
# *.mqproj    (Project files)
# *.json      (config files at root)
# *.md        (documentation)
# *.set       (setting files)
**/Data/system_status.json 
**/Data/forward_test_events.csv 
**/Data/forward_test_session.csv 
**/Data/forward_test_trades.csv 
**/Data/*.db 
**/Data/*.json 
  
# --- Runtime statistics / auto-generated test outputs ---  
Files/XAU_AI_PRO_stats.csv

# --- Dados gerados pelo pipeline AI (nao versionar) ---
*.pkl
**/Data/*.pkl
Files/Common/
Files/Data/*.json
Files/Data/prediction.json  
  
# --- App XAU_AI_PRO: repo git aninhado (sincronizado em Files/XAU_AI_PRO/.git) ---  
Files/XAU_AI_PRO/  
  
# --- Artefatos locais / screenshots ---  
Files/*.png  
Files/ChatGPT Image *.png

# --- Backups e artefatos de edicao automatica (nao versionar) ---
*.pre_p*
*.bak_before_p*
*.bom
*.orig
*.rej
Experts/Temp/
Profiles/Tester/*.opt
Profiles/Tester/*.htm
Profiles/Tester/*.xml
experts.dat  

# canal EQUIPE - estado mutavel (nao versionar backups nem lock)
Experts/XAU_AI_PRO/EQUIPE/_SYNC/backup/
Experts/XAU_AI_PRO/EQUIPE/_SYNC/LOCK
# --- Artefatos de medicao/backup locais (nao versionar) ---
*.bak_*
Scripts/Temp/

# estado gerado pelas ferramentas do dono (nao e fonte)
Experts/XAU_AI_PRO/EQUIPE/ORDEM_MASTER_ESTADO.json
Experts/XAU_AI_PRO/EQUIPE/BRIEFING_ATUAL.md

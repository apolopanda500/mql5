# ============================================================
# MQL5 / MetaTrader 5 - .gitignore
# Projeto: XAU_AI_PRO v1.2.0
# ============================================================

# --- Compiled / Binary Output ---
*.ex5
*.ex4
*.dll

# --- Logs ---
*.log

# --- Data / Temp Files ---
**/Data/*.csv
**/Data/prediction_*.json
*.dat
*.db
*.sqlite
*.sqlite3
*.tmp
*.cache

# --- MQL5 Editor / MetaEditor ---
.mq5.user/
*.mq5.user

# --- Python / AI Pipeline ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.venv/
venv/

# --- Temp / Backup ---
Files/Temp/
Files/Backup/
*~
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# --- MetaTrader Auto-generated Profiles ---
# (arquivos criados/alterados automaticamente pelo terminal)
Profiles/Charts/**/*.chr
Profiles/Charts/**/*.wnd

# --- MQL5 Logs Directory ---
logs/

# --- Preserve ---
# *.mq5       (Expert Advisors - source)
# *.mqh       (Include files - source)
# *.mqproj    (Project files)
# *.json      (config files at root)
# *.md        (documentation)
# *.set       (setting files)
**/Data/system_status.json 
**/Data/forward_test_events.csv 
**/Data/forward_test_session.csv 
**/Data/forward_test_trades.csv 
**/Data/*.db 
**/Data/*.json 
  
# --- Runtime statistics / auto-generated test outputs ---  
Files/XAU_AI_PRO_stats.csv  

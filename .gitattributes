# Binary files
*.ex5     binary
*.ex4     binary
*.dll     binary
*.dat     binary
*.csv     binary
*.db      binary
*.sqlite  binary
*.sqlite3 binary

# Images
*.bmp     binary
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary

# MQL5 source - text
*.mq5     text eol=lf
*.mqh     text eol=lf
*.mqproj  text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# MetaEditor grava .set em UTF-16 (BOM) - tratar como binario evita ruido no diff
*.set     binary

# Scripts PowerShell rodam no Windows - manter CRLF
*.ps1     text eol=crlf

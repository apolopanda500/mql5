// XAU_AI_PRO v1.2.9 - VersionManager v2.0 (ETAPA 10)
// Versao padronizada, build date, registro do estado dos modulos.
// SEM auto-update: atualizacao somente controlada/manual (seguranca).
#ifndef VERSION_MANAGER_MQH
#define VERSION_MANAGER_MQH

// Versao do PRODUTO. Precisa acompanhar o arquivo `VERSION` na raiz, que e a
// fonte unica propagada por `scripts/sync_version.py`.
//
// Estava em "1.2.0" enquanto o produto e 1.2.4: o `[VERSION]` que o EA
// escreve no log, e que a tela mostra, dizia uma versao que nao existe mais.
// Este modulo nao esta na lista de manifestos do `sync_version.py`, entao a
// divergencia nao era detectada por `--check`.
#define EA_VERSION_STRING "1.2.129"

struct VersionInfo
{
   string version;
   string build_date;
   string author;
   string changes;
   bool   stable;
};

class CVersionManager
{
private:
   static VersionInfo m_current;
   static bool     m_initialized;
   static bool     m_auto_update;
   static int      m_module_count;
   static string   m_modules[32];
   static string   m_module_state[32];
   static void RegisterModule(const string name, const string state);
public:
   static void Init();
   static void RegisterModules();
   static void CheckForUpdates();            // sem auto-update: apenas informativo
   static bool DownloadUpdate(const string version);   // bloqueado (seguranca)
   static void SetAutoUpdate(bool enable);   // forca false
   static string GetCurrentVersion();
   static VersionInfo GetVersionInfo();
   static string GetModulesSummary();
   static string GetStatus();
   static void LogStatus();
};

VersionInfo CVersionManager::m_current;
bool CVersionManager::m_initialized = false;
bool CVersionManager::m_auto_update = false;
int  CVersionManager::m_module_count = 0;
string CVersionManager::m_modules[32];
string CVersionManager::m_module_state[32];

void CVersionManager::Init()
{
   if(m_initialized) return;
   m_initialized = true;

   m_current.version    = EA_VERSION_STRING;
   m_current.build_date = TimeToString(TimeCurrent(), TIME_DATE);
   m_current.author     = "XAU_AI_PRO Team";
   m_current.changes    = "v1.2.129 (03/11/2026) - P2.20: a mensagem de erro do gateway culpava o token sem evidencia. MEDIDO no journal as 23:38:11: '[AI] GATEWAY | HTTP 401 | ... | 401/403 = token ausente ou invalido (AIGatewayToken)' era texto FIXO - saia igual para token vazio, token recusado, 404 de rota e 5xx de backend, e ainda repetia a lista de hipoteses em cada linha. Agora o motivo e classificado por evidencia: 401/403 com AIGatewayToken vazio vira 'token AUSENTE'; com token preenchido vira 'token RECUSADO (N caracteres enviados)' sem nunca imprimir o valor; 404 aponta AIGatewayUrl/rota; 422 aponta parametros; 5xx aponta backend. A mesma linha passou a declarar 'WebRequest=LIGADO (a chamada SAIU)' e o tamanho do corpo, que e a prova de que o defeito nao e a allowlist. Na falha de transporte (-1), 4014 deixou de ser publicado como 'WebRequest desabilitado': tem DUAS causas (URL fora da lista ou checkbox desligado) e o texto agora diz as duas, com 4060/5200/5202 separados. Mesma correcao de raiz do P2.19, agora no EA. v1.2.128 (03/11/2026) - P2.19: o diagnostico de WebRequest mandava o operador ao lugar errado. MEDIDO neste terminal as 23:18:44 e reconfirmado as 23:36:13: http://127.0.0.1:9001/api/ai/predict PASSOU a lista (HTTP=401, portanto a chamada saiu) e as outras 5 URLs devolveram 4014, que o Scripts/XAI_WebRequestCheck.mq5 traduzia como WebRequest DESABILITADO em Opcoes > Expert Advisors. As duas leituras nao podem ser verdadeiras ao mesmo tempo: se uma URL passou, o checkbox esta ligado, e o 4014 das restantes significa URL fora da lista. A mensagem errada mandava o operador conferir um controle que ja estava certo e escondia o defeito real. Correcao, so de diagnostico: o 4014 passa a ser descrito como NAO PERMITIDO (URL fora da lista, ou checkbox desligado), o script acumula as URLs bloqueadas por 4014/4060 e o fim imprime um VEREDITO que separa as duas causas por EVIDENCIA - basta UMA URL passar para provar checkbox ligado - mais uma linha ACAO com a lista exacta a adicionar em Allow WebRequest for listed URL. Provado em runtime as 23:36:13.798: VEREDITO | WebRequest esta LIGADO (1 URL(s) passaram a lista) | o defeito e a LISTA, nao o checkbox. Nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda apenas o texto de journal de um script de diagnostico. v1.2.127 (03/11/2026) - P2.18: o [CENARIO] publicava o SENTINELA como se fosse medicao. MEDIDO no journal do expert as 22:32:56.730 de 03/11: [CENARIO] EURUSD | TENDENCIA_FRACA | ADX=20.6 | ATR%=-1.00 | tendencia=RANGING | lote x0.90 | alvo x1.00. O -1.00 nao e volatilidade, e o valor que MarketVolatilityPercent() devolve quando nao conseguiu ler o ATR (atr<=0 ou preco<=0), e GetADX() devolve <=0 na mesma situacao; a DETECAO sempre tratou esses valores como ausencia de leitura (volPct>0.0 e adx<=0 em MarketScenarioDetect), mas as duas funcoes que ESCREVEM a linha - o [CENARIO] por simbolo e o [CENARIO] RETRATO - imprimiam o valor cru. Correcao: nascem ScenarioADXStr() e ScenarioAtrPctStr() em Filters/MarketScenario.mqh, que traduzem o sentinela para a palavra sem leitura, e os quatro pontos de impressao (2 no retrato, 2 na linha por simbolo) passam a usar os helpers. Deteccao, ScenarioLotFactor, ScenarioTargetFactor e a leitura dos indicadores ficam exactamente iguais. Nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado: muda apenas o texto de uma linha de journal que antes podia ser lida como medida. v1.2.127 (03/11/2026) - P2.17: o erro 4022 do CopyBuffer dizia falha e era aquecimento. MEDIDO no journal do expert as 21:54:03 de 03/11, com 15 graficos: [SIGNAL] SEM LEITURA | GBPUSD | falha ao copiar EMA Fast | Error=4022 repetido uma vez por grafico, quando 4022 (ERR_INDICATOR_DATA_NOT_FOUND) significa que o MT5 ainda nao calculou o indicador depois do reload e nao que o dado falte. Correcao, so de diagnostico: os tres blocos CopyBuffer<=0 do sinal (EMA Fast, EMA Slow, RSI) passam a ler GetLastError() e BarsCalculated() e a distinguir EMA Fast em aquecimento (MT5 calcula apos reload) de falha ao copiar EMA Fast, publicando BarsCalc, Error e o aviso de 1 linha por hora por conta e simbolo. A classificacao do sinal devolve 1/-1 exactamente nas mesmas condicoes de antes. Nenhuma regra de entrada ou de saida, lote, alvo, stop, spread, preco ou parametro de risco foi alterado. v1.2.126 (03/11/2026) - P2.16: o token do servidor MCP embutido estava escrito em Core/Config.mqh, portanto publico no GitHub, e o servidor arrancava com ele nos 15 graficos (medido: [MCP] servidor ativo | metodos=7/7 risk=ok ai=ok health=ok account=ok positions=ok ... as 21:44:59). Correcao sem tocar em trading: EnableMCPServer passa a falso por omissao, MCPServerToken passa a vazio no codigo (token privado vai no input do grafico) e o valor antigo e recusado em runtime, com uma linha por conta por hora. Nenhuma regra de entrada ou saida, lote, alvo, stop, spread ou preco foi alterada. " +
                            "v1.2.125 (03/11/2026) - P2.15: o mesmo veto de validacao saia uma vez por GRAFICO. MEDIDO no journal do expert, so impressao: [VALIDATION] BLOCK | TREND SELL | <simbolo> | contramao vetada | ADX indisponivel apareceu 23 vezes na sessao, sempre o mesmo texto para o mesmo par simbolo+motivo, porque a janela de 5 min de ValidationLogAllowed e por INSTANCIA (comentario de v1.2.16) e o terminal tem 15 graficos. Correcao: o corpo antigo virou ValidationLogAllowedLocal e ValidationLogAllowed passou a exigir tambem o portao por CONTA (Monitoring/AccountLogGate.mqh) com a mesma janela de 5 min, com a tag saneada para nome de ficheiro. O g_validationLastBlock continua a ser escrito antes de qualquer filtro, no tester nao ha portao e nenhuma validacao, limite ou regra de entrada mudou - so a repeticao da linha no journal. " + "v1.2.124 (03/11/2026) - P2.14: a rajada de [STOP] do reload ainda passava uma vez, na estreia do portao. MEDIDO no journal do expert, so impressao: o reload de 21:29:47 (o primeiro com o P2.13) deixou 15 linhas [STOP] com o MESMO motivo=2 e a MESMA equity=12592.02, e o reload seguinte, as 21:32:13, deixou 1 - a diferenca nao era a correcao, era o ficheiro do portao ja existir. Causa: AccountLogGatePodeImprimir le o carimbo, compara e escreve sem bloqueio, e no primeiro uso as 15 instancias leem nunca impresso ao mesmo tempo. Correcao: no motivo REASON_RECOMPILE, que e o unico simultaneo, a linha sai so da dona do pipeline (ChartID()==PipelineMasterChart()), eleicao ja existente e unica por conta; os outros motivos continuam no portao 1x/120 s. Sem dona publicada o portao decide como antes, e no tester nada muda. Nenhuma transicao de estado, contador, lote, alvo, stop, spread, preco, regra de entrada ou de saida foi alterado. " + "v1.2.123 (03/11/2026) - P2.13: tres linhas de journal repetiam o MESMO facto uma vez por grafico, e uma delas custava um FileOpen por tick. MEDIDO no journal do expert (filtro por programa, 15 instancias) nesta sessao: (a) cada reload deixa 15 linhas [STOP] no mesmo segundo - 21:15:11, 21:19:10 e 21:26:23 de 03/11, todas com motivo=2 e a MESMA equity (12583.02, 12589.19 e 12592.02); (b) a primeira observacao de um simbolo por instancia imprimia [STATE] USDCAD | -> MANAGING sem filtro nenhum, e entre 21:15:14 e 21:15:19 sairam 11 linhas iguais em 5 segundos, uma por grafico, para a MESMA posicao e o MESMO estado; (c) o [PIPELINE] STANDBY avancava o carimbo SO quando a linha saia, portanto enquanto o portao por conta respondia que outra instancia ja tinha escrito, a condicao ficava verdadeira para sempre e o FileOpen do portao corria a cada tick nas 14 instancias em espera. Correcao, so de impressao e de IO de log: (a) o [STOP] passa a 1 linha por conta e por motivo numa janela de 120 s, e um motivo NOVO continua a sair na hora; (b) a primeira observacao de um simbolo passa a 1 linha por conta e por simbolo por hora, com a transicao REAL intacta e sem filtro - o ramo que ja imprimia sempre para estado >= EXECUTION_READY continua exactamente igual; (c) o carimbo do STANDBY passa a avancar em toda a tentativa, logo o portao e consultado no maximo 1x por hora por instancia em vez de a cada tick. No tester nada muda: nao ha portao e as linhas saem como antes. Contas: a rajada do reload cai de 15 linhas [STOP] para 1 e o [STATE] de 11 para 1 por hora por simbolo. Nenhuma transicao de estado, contador, lote, alvo, stop, spread, preco, regra de entrada ou de saida foi alterado. " + "v1.2.122 (03/11/2026) - P2.12: a linha que registava o resultado de um trade dizia o simbolo ERRADO. MEDIDO no journal do terminal as 20:50:33 de 03/11, no fecho de uma posicao USDCHF de +10.00 USD: a linha saiu como 2026.11.04 01:50:33 | [TRADE] | USDCOP | Statistics trade registrado | WIN | 10.00, e a MESMA linha saiu com USDCLP no mesmo instante. A causa e o prefixo do Logger, que e sempre _Symbol - o simbolo do GRAFICO - e nao o simbolo NEGOCIADO; com 15 graficos o mesmo fecho ganhava 15 nomes e o journal passava a atribuir lucros a simbolos que nao os tiveram. Correcao: StatisticsRegisterTrade passa a receber o simbolo negociado e o ticket do deal (lidos no OnTradeTransaction a partir do proprio deal) e a linha publica negociado=<simbolo> | deal=<ticket>. O aprendizado por simbolo ([AI MEMORY], WR/MEM/BOOST) nunca esteve em causa, porque le sempre do deal. Este ciclo nao altera contadores, win rate, streaks, lote, alvo, stop, spread, preco, regra de entrada ou de saida. " + "v1.2.121 (03/11/2026) - P2.09: O EA NAO COMPILAVA desde o bloco de SQLite da v1.2.116, e o erro estava a vista ha varios ciclos. MEDIDO agora com o compilador a apontar para o EA - e nao para o script de sonda, que era o alvo por omissao da ferramenta e por isso os ciclos anteriores reportavam 0 erros: 22 erros, todos com uma unica causa raiz. Monitoring/TradeLoggerSQLite.mqh faz include de Database.mqh, ficheiro que NAO existe no MQL5 nem no projecto, e o compilador responde file Database.mqh not found na linha 10 do header; como o include falha, o resto do ficheiro fica por declarar e o EA recebe undeclared identifier para STradeRecord, TradeLoggerSQLiteInit, TradeLoggerSQLiteLog e TradeLoggerSQLiteShutdown nas linhas 1867 a 1891. Correcao: o modulo inteiro passa a estar atras da macro XAI_USE_TRADELOG_SQLITE, DESLIGADA por omissao, com o include e o bloco de chamada protegidos pela mesma macro - o mesmo padrao que o P1.58 usou para o sqlite3.dll, para o EA carregar em qualquer terminal sem dependencia externa. O codigo fica preservado no ficheiro e liga-se fornecendo o Database.mqh e definindo a macro. Nenhum registo se perde: o LogTradeCSV, que sempre foi o caminho real de gravacao de trades, continua exactamente igual, e era o unico que alguma vez correu. Fica tambem registada a licao de medicao: a ferramenta de compilacao tinha XAI_LogGateProbe.mq5 como fonte por omissao e compilar sem indicar o EA dava 0 erros sobre um ficheiro que nao e o EA. Nenhuma ordem, limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado. " + "v1.2.120 (03/11/2026) - P2.08: pedido do dono - ligar o servidor MCP com token. MEDIDO por leitura de codigo antes de mexer: os inputs estavam EnableMCPServer=false e MCPServerToken vazio, e o CMCPServer::Init ja desligava o servidor com token curto e dizia por que, logo o que faltava era um token com os 8 caracteres minimos e o interruptor ligado. Faltava tambem prova de que a API responde: a unica linha existente dizia servidor inicializado e nunca chamava um metodo, portanto nao distinguia API viva de API morta. Correcao: EnableMCPServer passa a true e MCPServerToken passa a um token local de 18 caracteres, e nasce o CMCPServer::SelfTest, que corre os SETE metodos de LEITURA - risk.status, ai.signal, health.status, account.info, positions.open, checklist.status e gate.verdict - e publica a contagem e o estado de cada um numa unica linha [MCP] servidor ativo, no maximo 1x por hora por conta. O ramo de falha deixou de escrever sem filtro e passa a dizer o numero de caracteres lidos e o minimo exigido, para o proximo erro ser medivel sem leitura de codigo. Nenhuma ordem, limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: o servidor MCP so le estado e o trade.validate continua a validar sem enviar. Fica medido e registado como pendencia que o EA nao abre socket e que nenhum caminho do EA chama MCPHandleRequest, logo o token protege uma API in-process e nao um porto de rede. " + "v1.2.119 (03/11/2026) - P2.07: primeiro ciclo medido com a v1.2.118 em producao nos 15 graficos. MEDIDO no MQL5/Logs/20261103.log na janela estavel 08:09:40 a 08:41:06 (31,4 min, 90 linhas, 2,9 linhas/min, zero linhas sem tag) contra a baseline de 7,3 linhas/min da v1.2.116: o [CENARIO] caiu de 11 linhas de rajada para UMA unica linha RETRATO as 08:10:45 com os 10 simbolos e os seus factores, o [BACKUP] deixou de repetir o resumo do gestor e o numero de snapshots removidos passou a uma linha so (snapshots antigos removidos=9), e o [PIPELINE] STANDBY caiu de 7 linhas em 5,5 min para 1 em 31 min, com zero linhas [DIAG] LOGGATE - prova de que a partilha de ficheiro do P2.05 resolveu a abertura recusada. Sobrou o [SCANNER] com 25 das 90 linhas, e as rajadas eram TODAS do heartbeat de 30 min: as 08:39:44 seis simbolos com o MESMO desfecho normal (NoSignal, Stale) escreveram em fila no mesmo ciclo. Correcao: os baldes NORMAIS (CanOpen, JaNegociado, Cooldown, Stale, NoSignal, DirHist) deixam de ter heartbeat por simbolo e saem apenas quando o desfecho MUDA, que e quando ha informacao; o [SCANNER] RESUMO continua a publicar a contagem por balde de cada janela, logo nada se perde. So AllowTrade e ExecFail mantem heartbeat de 30 min, porque um deles parado ha meia hora significa que o EA tentou entrar e nao conseguiu. Segundo defeito corrigido no mesmo bloco, de FIDELIDADE e nao de volume: o memo do desfecho era actualizado ANTES do portao por conta, portanto uma mudanca abafada pela janela de 30 min nunca mais era tentada e o simbolo ficava invisivel ate voltar a mudar; passou a avancar so depois do portao. Contas: o [SCANNER] BLOCK cai de cerca de 1 100 linhas por dia para apenas as mudancas reais. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.118 (03/11/2026) - P2.06: o [CENARIO] era o maior emissor da janela estavel e a maior parte nao era mudanca de estado, era o retrato inicial. MEDIDO em MQL5/Logs/20261103.log na janela 07:30:57 a 07:36:26 com a v1.2.116: [CENARIO] 11 linhas escritas entre 07:31:00.438 e 07:31:04.816, todas no master USDCNH, para a MESMA foto de mercado de 11 simbolos, e 236 linhas no dia. Causa: em cada reload o cache da instancia esta vazio, os 11 simbolos aparecem como MUDOU e o P2.04 ja so conseguia limitar a 1 por hora por simbolo - o que ainda sao 11 linhas de rajada sempre que a hora vence. Correcao: a PRIMEIRA observacao de cada simbolo passa a ser acumulada em memoria e publicada como UMA unica linha [CENARIO] RETRATO no fim do ciclo (ScenarioSnapFlush, chamada pelo scanner), com janela de 1 hora por CONTA; o cache fica actualizado no momento da observacao, logo a proxima mudanca REAL de classe, regime, factor de lote ou factor de alvo continua a sair na hora, por simbolo, e sem filtro, e o heartbeat por simbolo nao muda. Contas: a rajada do reload cai de 11 linhas para 1 e o [CENARIO] de cerca de 236 linhas por dia para cerca de 30, sem perder nenhuma mudanca de cenario. Foi tambem autorizada e executada a limpeza das copias antigas dentro de Experts/XAU_AI_PRO (109 ficheiros .pre_pNNN, .bak_before_pNNN, .bak e .orig, 2,9 MB) que nao eram compiladas mas inflavam todos os censos. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.117 (03/11/2026) - P2.05: o ciclo anterior cortou GLOBAL e AI e a janela estavel seguinte mostrou os dois emissores que sobraram, ambos de ESTADO e nao de decisao. MEDIDO no MQL5/Logs/20261103.log na janela estavel 07:30:57 a 07:36:26 (5,5 min, 40 linhas, 7,3 linhas/min, zero linhas sem tag): [CENARIO] 11, [BACKUP] 9, [PIPELINE] 9, [VALIDATION] 3, [SCANNER] 2, [RESUMO] 2, [SESSION] 1, [SIGNAL] 1, [DATA] 1, [STATE] 1, com [AI] 0 e [GLOBAL] 0 contra 27 e 30 da baseline 07:00 a 07:15. Tres correcoes, todas de impressao. (1) BACKUP: o CBackupManager imprimia uma linha por snapshot removido - 7 linhas seguidas as 07:31:28 - e o EA escrevia de novo o resumo que o proprio BackupManager ja tinha escrito (copiados=99 falhas=0), logo cada backup gastava 9 linhas para dizer uma coisa; o detalhe por ficheiro passa a uma unica linha com a contagem e o resumo duplicado do EA deixa de sair, porque o BackupManager ja o publica nas duas ramificacoes, sucesso e problema. (2) LOG GATE: na mesma janela o [PIPELINE] STANDBY saiu 7 vezes, uma por grafico, apesar de a janela ser de 3600 s por CONTA; o ficheiro Common/Files/XAU_AI_PRO/loggate_pipe_standby.bin ficou com data de 07:25:50 e nunca mais foi escrito, o que so acontece quando o FileOpen devolve INVALID_HANDLE e o gate cai no fail-open. Os 15 graficos correm em threads diferentes no mesmo terminal e abrem o MESMO ficheiro sem partilha declarada; o FileOpen passa a pedir FILE_SHARE_READ e FILE_SHARE_WRITE, que e a explicacao provavel desta abertura recusada. (3) O fail-open continua a ser a regra - erro de log nunca esconde informacao - mas deixa de ser invisivel: quando o ficheiro falha sai no maximo 1 linha [DIAG] LOGGATE falhou por hora por instancia, com a tag, a janela e o codigo do erro, para a proxima janela poder provar se o throttle voltou a funcionar. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.116 (03/11/2026) - P2.04: a v1.2.115 entrou em producao nos 15 graficos e a janela de recarga mostrou o proximo emissor a corrigir. MEDIDO no MQL5/Logs/20261103.log, janela POS 07:25:46 a 07:28:19 (2,6 min, 205 linhas, ainda a recarregar): [CENARIO] 31 a mais cara da janela, [SCANNER] 26, [PIPELINE] 14, [SIGNAL] 12, [GLOBAL] 10, [VALIDATION] 6, [AI] 1 contra 27 no intervalo 07:00-07:15 da v1.2.111. O [CENARIO] nao vinha do heartbeat: em cada reload o cache da instancia esta vazio, todos os 11 simbolos do scanner aparecem como MUDOU e os 15 graficos republicam a mesma foto. Uma primeira observacao nao e mudanca de estado, logo passa a usar gate por CONTA e por simbolo (cenario_cfg_, 3600 s); o cache e actualizado antes de sair, de forma que a proxima mudanca REAL de classe, regime, factor de lote ou factor de alvo sai na hora, sem filtro. Contas: o bloco de [CENARIO] no arranque cai de 11 simbolos por grafico para 11 por hora por conta. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas quando a mesma foto inicial vai para o journal. " + "v1.2.115 (03/11/2026) - P2.03: o [AI] era a familia mais cara do dia e a fatia maior nao era informacao nova, era a mesma causa repetida por simbolo. MEDIDO no MQL5/Logs/20261103.log as 07:18, com a v1.2.111 ainda a correr nos 15 graficos: 7 944 linhas no dia, [AI] 951, e nas ultimas 150 linhas [GLOBAL] 40, [SIGNAL] 26, [AI] 24. O aviso [AI] PREDICAO VENCIDA usava a chave ai_stale_ mais o simbolo, com janela de 3 600 s, o que dava um maximo de 15 linhas por hora (uma por simbolo) enquanto o AIGateway esta parado e a IA fica SEM PRECO. A causa e uma so para a conta e a linha ja nomeia o simbolo, logo a chave passa a ser da CONTA (ai_stale, 3 600 s): o mesmo aviso, com o mesmo texto e o mesmo simbolo, mas no maximo 1 por hora em vez de 15. Contas: o [AI] PREDICAO VENCIDA cai de ate 15 por hora para 1 por hora, ou seja de cerca de 360 linhas por dia para 24. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: o codigo de deteccao de predicao velha, o ResetAIState e o bloqueio de execucao continuam exactamente iguais, muda apenas quantas vezes o mesmo aviso vai para o journal. " + "v1.2.114 (03/11/2026) - P2.02: o P2.01 cortou GLOBAL, SIGNAL BUY/SELL e o RESUMO do scanner, mas a cauda do journal continuava a repetir dois retratos. MEDIDO no MQL5/Logs/20261103.log as 07:15, com a v1.2.111 ainda a correr nos 15 graficos: 7 916 linhas no dia, [SIGNAL] 340, [CENARIO] 234, e nas ultimas 150 linhas SIGNAL 24 e CENARIO 14 - as duas familiares mais caras a seguir ao [AI] e ao [GLOBAL]. Duas correcoes, ambas de impressao: (1) o [SIGNAL] NEUTRO saia 1x/15 min por simbolo em CADA grafico, com a mesma tendencia, as mesmas EMA50/EMA200 e o mesmo RSI nos 15 graficos; passa a 1x/hora por simbolo e por CONTA (sig_neu_, 3600 s por CONTA). (2) o [CENARIO] tinha um heartbeat de 900 s por INSTANCIA que so servia para provar que o EA estava vivo; passa a 1x/hora por CONTA e por simbolo (cenario_hb_, 3600 s por CONTA), mas a linha que MUDA - classe, regime, factor de lote e factor de alvo - continua a sair na hora, sem filtro, exactamente como antes. Contas: o [SIGNAL] NEUTRO cai de 11 simbolos por ciclo para 11 por hora no maximo e o [CENARIO] heartbeat cai de 11 por ciclo para 11 por hora no maximo, ou seja as duas familias deixam de acompanhar o ciclo de 5 minutos. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.113 (03/11/2026) - P2.01: o P2.00 cortou o volume por ciclo e o journal ficou legivel, mas a janela seguinte mostrou as fontes que ainda escreviam a MESMA linha varias vezes. MEDIDO no ficheiro MQL5/Logs/20261103.log as 07:07, com a v1.2.112 ja a correr: 7 832 linhas no dia e, nos 2 minutos depois do reload (07:05:20 em diante), apenas 4 linhas - a reducao e real e nenhuma linha de DECISAO foi perdida. Essas 4 linhas eram exactamente o problema que sobrava: o [SIGNAL] SELL em USDCNH, com RSI 74.26, saiu 4 vezes entre as 07:03 e as 07:06 com o MESMO RSI, o [SCANNER] RESUMO saiu a cada 30 segundos, o [STATUS] sai 1x/30 min por instancia e o [GLOBAL] continuava a sair 11 vezes por ciclo (uma por simbolo, de 5 em 5 minutos, em cada um dos 15 graficos). Quatro correcoes, todas de impressao: (1) o [SIGNAL] BUY/SELL passa a sair quando a DIRECAO muda e, no maximo, 1x/hora por CONTA e por simbolo - a classificacao nao muda (o return continua a ser 1/-1 exactamente nas mesmas condicoes), muda so quando a linha e escrita; (2) o [SCANNER] RESUMO passa a exigir tambem a janela por CONTA de 15 minutos quando ha sinal ou trade, porque o retrato era o do ciclo anterior; os contadores ADX(sem/ok) e SIG(sem/neutro) so avancam quando a linha sai, para o delta publicado continuar a ser o do intervalo realmente impresso; (3) o [GLOBAL] passa de 5 minutos por instancia para 1x/hora por CONTA e por simbolo - classe, sessao, factor de lote e exposicao mudam devagar e sao iguais nos 15 graficos; (4) a linha de CONTEXTO do spread ([VALIDATION] com o spread lido e o maximo permitido) passa a 1x/hora por CONTA e por simbolo, mantendo intacto o veto real [VALIDATION] BLOCK por SPREAD. Contas: o [GLOBAL] cai de cerca de 3 000 linhas por dia para 11 por hora no maximo, o [SIGNAL] deixa de repetir o mesmo sinal e o RESUMO deixa de sair a cada ciclo. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.112 (03/11/2026) - P2.00: MEDIDO no journal do dia (pasta MQL5 Logs, 20261103.log) com a v1.2.111 ja a correr - 7 803 linhas as 07:01 - e a janela de 4 minutos depois do ultimo reload mostrou onde o volume ainda nascia: [PIPELINE] STANDBY 150 linhas no dia, [AI] LOAD 344, [PIPELINE] PROCESSANDO 176, [SCANNER] START 176, [SCANNER] POSITION CHECK OK 172, [AI] PREDICAO VENCIDA 129, [SYMS] AVISO 108. Os numeros sao contados no ficheiro, nao estimados. Cinco correcoes, todas de impressao: (1) o [PIPELINE] STANDBY usava um static POR INSTANCIA, logo 13 graficos em espera davam 13 linhas por hora a dizer o mesmo; passa a exigir tambem a janela por CONTA (pipe_standby, 1/hora). (2) O [PIPELINE] PROCESSANDO saia uma vez por simbolo em cada ciclo (11 linhas) e passa a 1 por CONTA e por hora. (3) O [SCANNER] POSITION CHECK OK foi REMOVIDA: dizia apenas que o simbolo ainda nao tinha sido bloqueado, e o desfecho real ja sai com simbolo e motivo em [SCANNER] BLOCK / [CENARIO] / [SIGNAL]; o [SCANNER] START passa a 1x/hora por CONTA e por simbolo. (4) O [AI] PREDICAO VENCIDA passa a 1x/hora por CONTA e por simbolo, porque as idades diferiam mas o facto era o mesmo, e o [AI] LOAD passa de 1x/hora para 1x/dia por CONTA e por simbolo, porque o caminho do ficheiro nao muda entre leituras. (5) O [SYMS] AVISO P1.19 e configuracao estatica e passa a 1x/dia por CONTA, e o [NOTIFY] SendNotification falhou passa a 1x/6h por CONTA e por codigo, com GetLastError() lido uma unica vez. Contas de hoje: cerca de 700 linhas por dia a menos e nenhuma linha de DECISAO perdida - todas as linhas cortadas eram estado ou configuracao repetida. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.111 (03/11/2026) - P1.99: o journal de 03/11 (7 224 linhas ate 06:50) tinha 347 linhas sem tag, e duas dessas linhas eram defeito, nao estilo. (1) Monitoring/ValidationChecklist.mqh: o else estava pendurado no if INTERNO (LogInicioDetalhe) e nao no if(g_validationPassed). MEDIDO: 316 linhas [VALIDATION] no dia, e 13 de cada 14 instancias escreviam 0 BLOCKED (diagnostico de init, nao impede execucao) com ZERO bloqueios - um erro com nome de erro para dizer que estava tudo bem. As chavetas devolvem o else ao if exterior: SEM BLOCKED quando passa (1x por conta) e a contagem real quando bloquear. (2) Monitoring/Diagnostics.mqh: o detalhe multi-linha era colapsado com StringReplace sobre a barra invertida + n, mas em MQL5 essa sequencia e barra invertida literal e nao quebra de linha, logo a troca nunca casava e o detalhe saia como 9 linhas SEM TAG por arranque (Python, JSON, CSV, Permissoes, Conta, Simbolo, IA, Arquivos, Indicadores e Sistema: 225 no dia). Passa a usar as quebras reais (CR LF, LF e CR) e a cortar em 300 caracteres. (3) O unico mojibake que chegava ao journal - [DATA] | Indicadores invalid... com 176 linhas iguais - passa a ASCII [DATA] SEM LEITURA e a sair 1x/1h por CONTA e por simbolo; as outras 7 strings do DataLogger com o mesmo defeito de codificacao (codigo, OHLC, simbolo e arquivo) tambem ficam ASCII, para o journal nao voltar a mostrar caracteres partidos. (4) Quatro familias de linhas que ainda nao tinham tag passam a ter: EXECUTION: BLOQUEADA e EXECUTION: MODO NOTICIA para [TRADE], RISK CALC USD para [RISK] CALC USD, TRADE OPEN para [TRADE] OPEN e SYSTEM STATUS WRITE ERROR para [STATUS] WRITE ERROR. (5) [AI] LOAD passa de 30 min por instancia para 1x/h por CONTA e por simbolo (250 linhas no dia a repetir o mesmo caminho de ficheiro) e o [SCANNER] RESUMO deixa de chamar simbolos ao que sao VISITAS de simbolo por ciclo (194 visitas em 11 simbolos). Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que, e quantas vezes, vai para o journal. " + "v1.2.110 (03/11/2026) - P1.98: o bit MQL_TRADE_ALLOWED e POR GRAFICO e a unica prova de que estava a 1 era o snapshot de INIT do ULTIMO grafico que escreveu ProductionChecklist.txt, que nem sempre e o grafico em causa. O [STATUS] passa a publicar [PERM] com os cinco bits medidos AGORA nesta instancia (MQL_TRADE_ALLOWED, TERMINAL_TRADE_ALLOWED, ACCOUNT_TRADE_ALLOWED, ACCOUNT_TRADE_EXPERT, TERMINAL_CONNECTED), logo a permissao fica verificavel no journal grafico a grafico, sem depender de ficheiro comum. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que a linha publica. " + "v1.2.109 (03/11/2026) - P1.97: quatro numeros do journal deixaram de poder ser lidos de duas maneiras. (1) [STATUS] Positions dizia 1 EA(magic) enquanto a aba Negociacao mostrava 0 no instante da auditoria: as duas leituras estavam certas em instantes diferentes (a posicao existia quando a linha saiu e fechou depois), por isso a linha passa a trazer ao lado PosTerminal, MargemUsada, MargemLivre e Equity, todos do mesmo instante, e a verificacao fica dentro da propria linha. (2) P/L passou a chamar-se P/Ldia(realizado) e FreeMargin passou a MargemLivre, porque o primeiro e o realizado do dia (balance menos o saldo do inicio do dia, 26,80) e nao o flutuante das posicoes abertas (0,00), e o segundo e AccountInfoDouble(ACCOUNT_MARGIN_FREE). (3) O [STATUS] passa a publicar [AI] SIMBOLO | idade | limite | estado | modelo: a idade da previsao so existia dentro do system_status.json do ULTIMO grafico que o escreveu, e por isso o JSON dizia age_seconds=30/stale=false enquanto Data/prediction_XAUUSD.json tinha 1860 s contra MaxPredictionAgeSec=900. (4) A linha Diagnostico: FALHAS DETECTADAS detalhava as 11 checagens e o journal mostrava apenas Broker: VERDE; passa a comecar pela contagem e a listar SOMENTE o que reprovou, com o detalhe de cada falha. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: (5) O [DIAG] FALHAS DETECTADAS era impresso por um else pendurado no if INTERNO de LogInicioDetalhe(), e nao no if(diagOK): saia exactamente quando todos os testes passavam, ao lado de [STATUS] HEALTHY. Passa a ter chavetas. Nenhum limite, regra de entrada ou de saida, lote, spread, alvo, precificacao ou parametro de risco foi alterado: muda apenas o que cada linha publica. " + "v1.2.93 (02/11/2026) - P1.80: restavam DUAS linhas SEM TAG no journal e as duas eram as do sinal. MEDIDO no Logs de 02/11 as 20:23 (MQL5, pasta Logs, 20261102.log): as unicas linhas fora do vocabulario [TAG] eram USDBRL SIGNAL BUY | RSI[1]=37.31, escritas por Core/SignalCore.mqh; houve 23 no dia e o mesmo par simbolo/RSI repetia-se nas 05:05, 05:31, 05:53, 05:56, 20:13 e 20:23, porque o RSI nao mudava. O defeito nao era so a tag: o throttle era um static UNICO partilhado por todos os simbolos, portanto o primeiro simbolo que escrevia no minuto gastava a vez e os outros ficavam invisiveis no journal - era impossivel saber quais simbolos tinham sinal no mesmo minuto. Duas correcoes, ambas de impressao: (1) as 6 mensagens de erro do sinal e as 2 mensagens de BUY/SELL passam a levar a tag [SIGNAL]; (2) o throttle passa a ser POR SIMBOLO (arrays estaticos indexados por simbolo, 60 s), como ja acontece em Core/MarketScanner.mqh. Efeito esperado: 0 linhas anonimas no journal de 03/11 e o sinal de cada simbolo visivel uma vez por minuto. Nenhum return, limite, regra de entrada ou de saida, lote, alvo, spread ou parametro de risco foi alterado. " + "v1.2.92 (02/11/2026) - P1.79: a melhoria anterior cortou as linhas SEM TAG, mas o journal continuava a repetir o mesmo facto porque ha 15 graficos e porque o texto se repete DENTRO do ciclo. MEDIDO no Logs de 02/11 as 20:16 (MQL5\\Logs\\20261102.log, 41 057 150 bytes, 185 920 linhas), janela de 4 000 linhas com a v1.2.91: 9,2 por cento sem tag (366 linhas, TODAS do DataLogger), [SCANNER] 116, [TRADE PIPELINE] 120, [LEARN] 243, [LOGGER OFFLINE] 82. Quatro correcoes, todas so de impressao: (1) o [SCANNER] SIGNAL OK passa a sair quando o sinal MUDA e no maximo 1x/30 min por simbolo, porque o mesmo USDBRL com Signal=1 imprimia de 6 em 6 segundos; (2) o [TRADE PIPELINE] INICIANDO passa de 1x/min por grafico para 1x/30 min por CONTA (era 15 x 1/min = 900 linhas/hora); (3) as 7 mensagens do DataLogger que ainda nao tinham tag passam a [DATA] e o DATA LOGGER SAVED passa a [DATA] SAVED com janela de 86400 s por CONTA e por simbolo - antes eram 11 simbolos x 15 graficos = 165 linhas por dia; (4) o retrato de ARRANQUE passa a ser escrito pelo PRIMEIRO grafico do reload e fica calado nos outros (Monitoring\\AccountLogGate.mqh, LogInicioDetalhe(), janela de 120 s por conta e cache por instancia): [VERSION] Modulos, [AI] Client, [REAL GUARD] demo, [BENCHMARK], [TELEMETRY], [ANTILOOP], [SYNC], [STATS], [QUALITY], [DATABASE], [VALIDATION] checklist, [SCHEDULER], [CHECKLIST] producao, [PATH] data, [LEARN] diario aplicado e [LEARN] resumo, e os instantaneos periodicos [DATABASE]/[SCHEDULER]/[TELEMETRY]/[BENCHMARK] passam a 1x/hora por conta. Se o ficheiro comum falhar, o portao devolve SEMPRE true: erro de log nunca esconde informacao. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado. " + "v1.2.91 (02/11/2026) - P1.78: o journal ja nao tinha linha sem tag, mas ainda dizia a MESMA coisa 16 vezes porque ha 16 graficos. MEDIDO no Logs de 02/11 as 19:54, janela de 1 280 linhas com a v1.2.90: [VERSION] 86, [INIT] 80, [LEARN] 80, [AI] 74, [NOTIFY] 59, [CONFIG] 59 - o mesmo facto escrito uma vez por instancia, mais [VALIDATION] 48, [BACKUP] 35, [DIAG] 33 e 32 de [RECOVERY], [REAL GUARD], [LOGGER OFFLINE], [CHECKLIST], [SCHEDULER], [BROKER] e [PATH]. O mecanismo certo ja existia desde o P1.73 (Monitoring\\AccountLogGate.mqh, janela por CONTA em Files\\Common\\XAU_AI_PRO\\loggate_<tag>.bin) e passa a cobrir o arranque: [INIT] system, [INIT] symbol manager, [INIT] execution engine e [INIT] all modules passam a 1 linha por conta por hora; [VERSION] e [VERSION] Modulos saem 1x por conta por hora, com a tag a incluir a versao (version_1.2.91) para que uma versao NOVA apareca sempre; [NOTIFY] sai 1x por conta e nao duas vezes por instancia, porque o OnInit do EA e o LogStatus do NotificationCenter passam a partilhar a mesma tag; [CONFIG] inicializado, [CONFIG] perfil ativo (tag com o NOME do perfil, logo um perfil novo imprime na hora) e [CONFIG] estado passam a 1x por conta por hora. O include do portao sobe para o topo do EA para que qualquer modulo possa chamar AccountLogGatePodeImprimir sem repetir o #include. As 7 linhas de falha de modulo que ainda nao tinham tag (ATR OFF, ADX OFF, RSI OFF, TrendFilter OFF, MTF OFF, DataLogger OFF, TradeLogger OFF) passam a [INIT] e a linha do SymbolManager passa a [SYMS], para que o journal nao volte a ter linha anonima. Se o ficheiro comum falhar, o portao devolve SEMPRE true: erro de log nunca esconde informacao. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado: muda apenas quantas vezes a mesma linha vai para o journal. v1.2.90 (02/11/2026) - P1.77: as ultimas 32 linhas sem tag eram todas do mesmo modulo. MEDIDO no Logs de 02/11 as 19:52, janela de 1 292 linhas (94 sem tag antes do P1.76, 357 antes do P1.75): 32 linhas sem tag, 2,5 por cento, e TODAS do AIConnector - 'AI LOAD', 'AI FILE NOT FOUND', 'AI INVALID JSON SYMBOL', 'AI GATEWAY', 'AI PYTHON', 'AI BLOCK'. O modulo escrevia no journal com nomes proprios, fora do vocabulario [TAG] que o resto do EA usa, e por isso nao se filtrava por tag nenhuma. As 11 mensagens passam a levar o prefixo [AI] e o journal deixa de ter linha sem tag: qualquer linha do journal pertence agora a um namespace. Duas mensagens foram renomeadas para portugues ('FILE NOT FOUND' -> 'FILE EM FALTA', 'JSON EMPTY' -> 'JSON VAZIO') para ficarem coerentes com o resto do journal. Nenhuma decisao de sinal muda: os 11 pontos sao Print de diagnostico, ja limitados a 1 vez por 30 minutos por instancia desde a v1.2.33. v1.2.89 (02/11/2026) - P1.76: ultimas linhas sem tag e a causa repetida. MEDIDO no Logs de 02/11 as 19:47, janela de 1 200 linhas (1 534 antes): 7,8 por cento sem tag contra 23,3 por cento, com o resto a ser o ENCERRAMENTO da v1.2.87. Ficaram duas linhas sem tag por instancia - 'Inicializando modulos...' (sem dados, o [INIT] all modules OK ja o diz) e o aviso do SymbolManager - e as duas passam a comentario e a [SYMS]. A causa de TG_MQL_OFF no diagnostico tem ~900 caracteres e saia 16x por arranque; passa a 'codigo=N | causa completa em [TRADE BLOCK]', porque o codigo identifica o bit e o texto completo continua no [TRADE BLOCK] uma vez por conta. v1.2.88 (02/11/2026) - P1.75: o journal ainda gastava 21 linhas sem tag por instancia, e 12 delas eram o ENCERRAMENTO. MEDIDO no Logs de 02/11 na janela 19:34:24-19:40:04 (1 534 linhas, 357 sem tag = 23,3 por cento): 32 separadores '====', 16 'XAU_AI_PRO FINALIZANDO', 16 'Reason=N', 16 'XAU_AI_PRO FINALIZADO', 16 'SYSTEM CLOSED', 16 'DATA LOGGER OFFLINE' e 16 blocos BACKTEST ANALYZER com Trades=0/PF=0.00, mais 9 linhas de arranque sem tag por grafico ('XAU_AI_PRO INITIALIZING', 'SYSTEM READY', 'Inicializando modulos...', 'MTF INIT', 'DATA LOGGER MULTI-SYMBOL ONLINE', 'TradeLogger inicializado', 'BACKTEST ANALYZER | Inicializado', 'AI GATEWAY | WebRequest falhou'). Correcao so de impressao: (1) o OnDeinit passa a escrever UMA linha [STOP] com simbolo, motivo e equity em vez de 5 (2 separadores, FINALIZANDO, Reason= e FINALIZADO) e o 'SYSTEM CLOSED' do ShutdownSystem deixa de sair, porque o [STOP] ja o diz com dados; (2) 'XAU_AI_PRO INITIALIZING' e 'SYSTEM READY' desaparecem (o [START] e o [INIT] system + signalcore OK ja os substituem com valores) e a falha de compatibilidade passa a '[SYSTEM] FAIL'; (3) as restantes 7 passam a ter tag: [DATA] logger multi-simbolo online, [DATA] logger offline, [TRADELOG] inicializado, [BT] inicializado, [BT] resumo e [MTF] INIT, e o erro do gateway passa a '[AI] GATEWAY falhou'; (4) o resumo de backtest deixa de sair quando nao houve nenhum trade, porque era uma linha de zeros por instancia. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado: muda apenas o texto e a quantidade de linhas que o EA escreve. v1.2.87 (02/11/2026) - P1.74: o journal deixou de contar o arranque 16 vezes. MEDIDO no journal de 02/11 (MQL5\\Logs\\20261102.log, 171 952 linhas, 37 439 482 bytes): 95 508 linhas (55,5 por cento) nao tinham tag nenhuma, e o arranque de UMA instancia custava 227 linhas - cerca de 3 600 num reload dos 16 graficos. Desse total, 107 eram dump decorativo e repetido: 57 do SymbolManager (Market Watch, lista de ativos, um Active symbol registered por simbolo), 20 do BrokerAnalyzer, 5 do BrokerInfo, 5 do EnvironmentManager, 5 do PathManager, 5 do BrokerConfig, 9 do cabecalho do OnInit, 11 do resumo de memoria aprendida e 20 separadores ==== e ---- sem informacao. Tudo isso passa a 10 linhas com tag: [START] conta/corretora/servidor/simbolo/saldo/equity, [SYMS] configurados/ativos/marketwatch/grafico/lista, [BROKER] dump do simbolo, [BROKER] conta, [ENV], [PATH] x2, [BROKERCFG], [LEARN] resumo e [INIT] pronto. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo, precificacao ou return foi alterado: muda apenas o texto e a quantidade de linhas que o EA escreve. " + "v1.2.86 (02/11/2026) - P1.73: MEDIDO no journal de 02/11 (167 665 linhas; 7 596 de [TRADE BLOCK], 5 848 de [LEARN], 3 745 de [SESSION], 2 285 de [VERSION], 1 095 de [HEALTH], 961 de [LOGGER OFFLINE]). O P1.72 cortou a repeticao DENTRO de cada grafico (TRADE BLOCK 68,1/h -> 1/h por instancia), mas o journal continuou a repetir texto IDENTICO porque ha 16 graficos: 16 x 1/hora = 16 linhas/hora por tag. Este ciclo corrige isso na raiz: o throttle deixa de ser por instancia e passa a ser por CONTA, num ficheiro comum (Monitoring\\AccountLogGate.mqh, Files\\Common\\XAU_AI_PRO\\loggate_*.bin). Sao tres pontos, todos so de impressao: (1) [TRADE BLOCK] com a MESMA causa passa a 1 linha/hora por conta (era 1/hora por grafico) e a causa NOVA passa a 1 linha/2 min por conta, porque o reload dos 16 graficos escrevia a mesma causa 16 vezes; (2) [SESSION] estado salvo passa a no maximo 1 linha/10 min por conta, no rollover de 03/11 sairam 12 linhas iguais em 40 segundos; (3) o resumo de hora do [HEALTH] passa a 1 linha/hora por conta, mas MUDANCA de estado continua a sair na hora, sem filtro. Se o ficheiro comum falhar (bloqueado, disco, permissao), o modulo devolve SEMPRE true: erro de log nunca esconde informacao. Nenhum limite, regra de entrada ou de saida, parametro de risco, lote, spread, alvo ou precificacao foi tocado. v1.2.85 (02/11/2026) - P1.72: MEDIDO na janela 17:40-18:44 do Logs de 02/11 (872 linhas, a janela silenciosa depois do reload): o journal ainda repetia retratos e o mesmo bloqueio. Os maiores emissores dessa janela eram [TRADE BLOCK] com 117 linhas da MESMA causa, [SESSION] estado salvo 64, [CIRCUIT] BROKER OK e BROKER INSTAVEL 64 (32 de cada, sempre em par) e [LEARN] varredura em espera 33. Correcao minima, so de impressao: (1) AllowBlockPrintCausa passa de 1x/10 min para 1x/hora por causa - a causa